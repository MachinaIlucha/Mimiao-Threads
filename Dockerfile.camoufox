FROM python:3.12-slim-bookworm
WORKDIR /app
ARG CPM_VERSION=0.6.0
ARG CPM_SHA256=d1aef0037030a085bf6d167a60e1026dafc3b1f1b4c4d39764e24354324e45e8
RUN apt-get update && apt-get install -y --no-install-recommends curl xvfb x11-utils x11vnc novnc websockify openbox ca-certificates && \
    curl -fL "https://github.com/polyackiy/camoufox-profile-manager/releases/download/v${CPM_VERSION}/camoufox_profile_manager-${CPM_VERSION}-py3-none-any.whl" -o /tmp/camoufox_profile_manager-${CPM_VERSION}-py3-none-any.whl && \
    echo "${CPM_SHA256}  /tmp/camoufox_profile_manager-${CPM_VERSION}-py3-none-any.whl" | sha256sum -c - && \
    pip install --no-cache-dir /tmp/camoufox_profile_manager-${CPM_VERSION}-py3-none-any.whl && \
    python -m playwright install-deps firefox && \
    useradd --uid 1000 --create-home browser && mkdir -p /data /app/data/media && chown -R browser:browser /data /app && \
    rm -rf /var/lib/apt/lists/* /tmp/*.whl
ENV DISPLAY=:99 CPM_DB_PATH=/data/profiles.db PYTHONUNBUFFERED=1
RUN mkdir -p /usr/local/lib/python3.12/site-packages/fpgen/data && \
    chown browser:browser /usr/local/lib/python3.12/site-packages/fpgen/data
USER browser
RUN python -m camoufox fetch
COPY --chown=browser:browser deploy/camoufox/ /app/
RUN chmod +x /app/entrypoint.sh
CMD ["/app/entrypoint.sh"]
