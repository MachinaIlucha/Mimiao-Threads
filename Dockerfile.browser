FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci && npx playwright install --with-deps chromium && \
    apt-get update && apt-get install -y --no-install-recommends xvfb x11-utils x11vnc novnc websockify openbox && \
    rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm run build && npm prune --omit=dev && \
    mkdir -p /app/data/media /app/data/threads-browser && \
    chown -R node:node /app && \
    mv /root/.cache/ms-playwright /opt/ms-playwright && chmod -R a+rX /opt/ms-playwright && \
    chmod +x /app/deploy/browser-entrypoint.sh
ENV NODE_ENV=production DISPLAY=:99 PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright BROWSER_PROFILE_DIR=/app/data/threads-browser
USER node
CMD ["/app/deploy/browser-entrypoint.sh"]
