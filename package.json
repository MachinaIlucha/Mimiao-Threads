{
  "name": "mimiao-threads-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx server/migrate.ts",
    "dev": "concurrently -k -n api,web,worker \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\" \"tsx watch server/worker.ts\"",
    "dev:api": "tsx watch server/index.ts",
    "worker": "tsx server/worker.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/manrope": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "motion": "^14.3.0",
    "pg": "^8.16.3",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
