DATABASE_URL=postgresql://studio:change-me@localhost:55439/studio
POSTGRES_PASSWORD=change-me
PUBLIC_URL=http://localhost:4319
PORT=4319
HOST=127.0.0.1
NODE_ENV=development
ENCRYPTION_KEY=
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
DEEPSEEK_API_KEY=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_API_VERSION=v1.0
MEDIA_DIR=./data/media
# Leave false until a test-account smoke has passed. The dashboard has a separate pause switch.
LIVE_PUBLISHING=false
# api (default) or browser. The browser overlay sets this for API and worker.
PUBLISHING_MODE=api
## Optional manager: compose.yml + compose.camoufox.yml
BROWSER_ENGINE=chromium
CAMOUFOX_URL=http://camoufox:8000
CAMOUFOX_STUDIO_KEY=
CAMOUFOX_OWNER_PASSWORD=
CAMOUFOX_SECRET_KEY=
BROWSER_PROFILE_DIR=./data/threads-browser
BROWSER_HEADLESS=false
# Separate 8-character VNC password. Not the Threads password. Only needed for VPS overlay.
BROWSER_DESKTOP_PASSWORD=
THREADS_PUBLIC_DISCOVERY_APPROVED=false
# Deployment only: DNS name without https://
STUDIO_DOMAIN=studio.example.com
